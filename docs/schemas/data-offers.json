{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "data_classification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "enum": [
        "SYNTHETIC_HACKATHON_DATA"
      ]
    },
    "not_for_production": {
      "type": "boolean",
      "enum": [
        true
      ]
    },
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "enum": [
        "1"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data_classification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "enum": [
              "SYNTHETIC_HACKATHON_DATA"
            ]
          },
          "not_for_production": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "effective_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "format": "date-time"
          },
          "review_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "enum": [
              "APPROVED_MOCK"
            ]
          },
          "maker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "checker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "legal_approval_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "approved_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "format": "date-time"
          },
          "predecessor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "rollback_reference": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_system": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "checksum": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "plan_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "enum": [
              "DEFERRED_INTEREST",
              "EQUAL_PAY_NO_INTEREST",
              "REDUCED_APR_FIXED_TERM",
              "CUSTOM_AMORTIZATION",
              "CASHBACK_REVOLVING",
              "STANDARD_REVOLVING"
            ]
          },
          "product_legal_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "minimum_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "maximum_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "eligible_categories": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "minItems": 1,
            "maxItems": 20
          },
          "excluded_item_types": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "minItems": 0,
            "maxItems": 20
          },
          "tax_eligible": {
            "type": "boolean"
          },
          "shipping_eligible": {
            "type": "boolean"
          },
          "eligibility_basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "enum": [
              "ELIGIBLE_BALANCE_AFTER_APPLIED_TENDER"
            ]
          },
          "allowed_applied_tender_types": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "enum": [
                "GIFT_CARD"
              ]
            },
            "minItems": 0,
            "maxItems": 1
          },
          "merchant_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "minItems": 1,
            "maxItems": 20
          },
          "program_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "minItems": 1,
            "maxItems": 20
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "minItems": 1,
            "maxItems": 10
          },
          "account_scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "term_months": {
            "type": "integer",
            "minimum": 0,
            "maximum": 120
          },
          "promo_apr_bps": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              {
                "type": "null"
              }
            ]
          },
          "apr_source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "enum": [
              "ACCOUNT_TERMS",
              "OFFER"
            ]
          },
          "allow_partial_financing": {
            "type": "boolean"
          },
          "allow_mixed_tender": {
            "type": "boolean"
          },
          "allow_multi_promo": {
            "type": "boolean"
          },
          "reward_stacking": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "enum": [
              "NONE"
            ]
          },
          "terms_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "terms_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "disclosure_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "disclosure_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "template_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "template_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "regulatory_profile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "policy_bundle_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "minItems": 1,
            "maxItems": 10
          },
          "jurisdiction_profile_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "minItems": 1,
            "maxItems": 10
          },
          "presentation_policy_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "presentation_policy_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "acknowledgment_required": {
            "type": "boolean"
          },
          "custom_schedule_bps": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "minItems": 0,
            "maxItems": 120
          },
          "reward": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "rate_bps": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "cap_cents": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000000
                  },
                  "vesting_days": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 365
                  },
                  "reversal": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "enum": [
                      "ON_RETURN"
                    ]
                  }
                },
                "required": [
                  "rate_bps",
                  "cap_cents",
                  "vesting_days",
                  "reversal"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "data_classification",
          "not_for_production",
          "id",
          "version",
          "effective_at",
          "expires_at",
          "review_at",
          "status",
          "maker",
          "checker",
          "legal_approval_id",
          "approved_at",
          "predecessor",
          "rollback_reference",
          "source_system",
          "checksum",
          "name",
          "plan_type",
          "product_legal_type",
          "minimum_cents",
          "maximum_cents",
          "eligible_categories",
          "excluded_item_types",
          "tax_eligible",
          "shipping_eligible",
          "eligibility_basis",
          "allowed_applied_tender_types",
          "merchant_ids",
          "program_ids",
          "channels",
          "account_scope",
          "term_months",
          "promo_apr_bps",
          "apr_source",
          "allow_partial_financing",
          "allow_mixed_tender",
          "allow_multi_promo",
          "reward_stacking",
          "terms_id",
          "terms_version",
          "disclosure_id",
          "disclosure_version",
          "template_id",
          "template_version",
          "regulatory_profile",
          "policy_bundle_ids",
          "jurisdiction_profile_ids",
          "presentation_policy_id",
          "presentation_policy_version",
          "acknowledgment_required",
          "custom_schedule_bps",
          "reward"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "data_classification",
    "not_for_production",
    "schema_version",
    "records"
  ],
  "additionalProperties": false
}
