{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "journey_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "merchant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^MOCK-[A-Z0-9-]+$"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^MOCK-[A-Z0-9-]+$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    }
  },
  "required": [
    "journey_id",
    "merchant_id",
    "agent_id"
  ],
  "additionalProperties": false
}
