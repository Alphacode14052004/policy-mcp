{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "merchant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^MOCK-[A-Z0-9-]+$"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^MOCK-[A-Z0-9-]+$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "journey_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "cart": {
      "type": "object",
      "properties": {
        "cart_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^MOCK-[A-Z0-9-]+$"
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "line_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "sku": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^MOCK-[A-Z0-9-]+$"
              },
              "category": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "item_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "unit_price_cents": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000000
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "line_id",
              "sku",
              "category",
              "item_type",
              "unit_price_cents",
              "quantity"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 50,
          "description": "Products being purchased. A gift card being redeemed is NOT a product line."
        },
        "tax_cents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "shipping_cents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "total_cents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000,
          "description": "Gross purchase total BEFORE payment tenders; must equal lines plus tax and shipping."
        },
        "applied_tenders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tender_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^MOCK-[A-Z0-9-]+$"
              },
              "tender_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "enum": [
                  "GIFT_CARD"
                ]
              },
              "amount_cents": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000000
              },
              "line_allocations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "line_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                    },
                    "amount_cents": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100000000
                    }
                  },
                  "required": [
                    "line_id",
                    "amount_cents"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 50
              }
            },
            "required": [
              "tender_id",
              "tender_type",
              "amount_cents",
              "line_allocations"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 10,
          "description": "Optional existing mock gift cards used as payment, with exact line allocations. No real card numbers or balance verification."
        }
      },
      "required": [
        "cart_id",
        "currency",
        "lines",
        "tax_cents",
        "shipping_cents",
        "total_cents"
      ],
      "additionalProperties": false
    },
    "jurisdiction": {
      "type": "object",
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "issuer_charter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "issuer_location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "product_legal_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "account_program": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^MOCK-[A-Z0-9-]+$"
        },
        "origination_channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "merchant_location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "consumer_residence_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "billing_state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "servicemember_status_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^MOCK-[A-Z0-9-]+$"
        },
        "servicemember_status_result": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "transaction_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "format": "date-time"
        }
      },
      "required": [
        "profile_id",
        "issuer_charter",
        "issuer_location",
        "product_legal_type",
        "account_program",
        "origination_channel",
        "merchant_location",
        "consumer_residence_state",
        "billing_state",
        "servicemember_status_source",
        "servicemember_status_result",
        "transaction_at"
      ],
      "additionalProperties": false
    },
    "offer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "receipt": {
      "type": "object",
      "properties": {
        "payload": {
          "type": "object",
          "properties": {
            "receipt_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "journey_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "merchant_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^MOCK-[A-Z0-9-]+$"
            },
            "agent_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^MOCK-[A-Z0-9-]+$"
            },
            "offer_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "terms_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "terms_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "policy_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "policy_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "disclosure_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "disclosure_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "offer_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "presentation_policy_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "presentation_policy_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "cart_digest": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "disclosure_digest": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "allocation_digest": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "context_digest": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "versions_digest": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "presented_at": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "format": "date-time"
            },
            "acknowledged_at": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "locale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "channel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "renderer_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "renderer_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "expires_at": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "format": "date-time"
            }
          },
          "required": [
            "receipt_id",
            "journey_id",
            "merchant_id",
            "agent_id",
            "offer_id",
            "terms_id",
            "terms_version",
            "policy_id",
            "policy_version",
            "disclosure_id",
            "disclosure_version",
            "offer_version",
            "presentation_policy_id",
            "presentation_policy_version",
            "cart_digest",
            "disclosure_digest",
            "allocation_digest",
            "context_digest",
            "versions_digest",
            "presented_at",
            "acknowledged_at",
            "locale",
            "channel",
            "renderer_id",
            "renderer_version",
            "expires_at"
          ],
          "additionalProperties": false
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "payload",
        "signature"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "merchant_id",
    "agent_id",
    "request_id",
    "correlation_id",
    "journey_id",
    "expected_version",
    "idempotency_key",
    "cart",
    "jurisdiction",
    "offer_id"
  ],
  "additionalProperties": false
}
