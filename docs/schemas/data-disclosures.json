{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "data_classification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "enum": [
        "SYNTHETIC_HACKATHON_DATA"
      ]
    },
    "not_for_production": {
      "type": "boolean",
      "enum": [
        true
      ]
    },
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "enum": [
        "1"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data_classification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "enum": [
              "SYNTHETIC_HACKATHON_DATA"
            ]
          },
          "not_for_production": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "effective_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "format": "date-time"
          },
          "review_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "enum": [
              "APPROVED_MOCK"
            ]
          },
          "maker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "checker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "legal_approval_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "approved_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "format": "date-time"
          },
          "predecessor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "rollback_reference": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_system": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "checksum": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "template_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "template_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "plan_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "enum": [
              "DEFERRED_INTEREST",
              "EQUAL_PAY_NO_INTEREST",
              "REDUCED_APR_FIXED_TERM",
              "CUSTOM_AMORTIZATION",
              "CASHBACK_REVOLVING",
              "STANDARD_REVOLVING"
            ]
          },
          "product_legal_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "locale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "channel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "template": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "allowed_vars": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "minItems": 1,
            "maxItems": 20
          },
          "protected_segments": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "minItems": 1,
            "maxItems": 10
          }
        },
        "required": [
          "data_classification",
          "not_for_production",
          "id",
          "version",
          "effective_at",
          "expires_at",
          "review_at",
          "status",
          "maker",
          "checker",
          "legal_approval_id",
          "approved_at",
          "predecessor",
          "rollback_reference",
          "source_system",
          "checksum",
          "template_id",
          "template_version",
          "plan_type",
          "product_legal_type",
          "locale",
          "channel",
          "template",
          "allowed_vars",
          "protected_segments"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "data_classification",
    "not_for_production",
    "schema_version",
    "records"
  ],
  "additionalProperties": false
}
