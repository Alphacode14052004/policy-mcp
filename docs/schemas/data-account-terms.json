{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "data_classification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "enum": [
        "SYNTHETIC_HACKATHON_DATA"
      ]
    },
    "not_for_production": {
      "type": "boolean",
      "enum": [
        true
      ]
    },
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "enum": [
        "1"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data_classification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "enum": [
              "SYNTHETIC_HACKATHON_DATA"
            ]
          },
          "not_for_production": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "effective_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "format": "date-time"
          },
          "review_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "enum": [
              "APPROVED_MOCK"
            ]
          },
          "maker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "checker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "legal_approval_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "approved_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "format": "date-time"
          },
          "predecessor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "rollback_reference": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_system": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "checksum": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "program_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "currency": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "enum": [
              "USD"
            ]
          },
          "standard_apr_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "apr_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "enum": [
              "VARIABLE",
              "FIXED"
            ]
          },
          "apr_source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "account_scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          }
        },
        "required": [
          "data_classification",
          "not_for_production",
          "id",
          "version",
          "effective_at",
          "expires_at",
          "review_at",
          "status",
          "maker",
          "checker",
          "legal_approval_id",
          "approved_at",
          "predecessor",
          "rollback_reference",
          "source_system",
          "checksum",
          "program_id",
          "currency",
          "standard_apr_bps",
          "apr_type",
          "apr_source",
          "account_scope"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "data_classification",
    "not_for_production",
    "schema_version",
    "records"
  ],
  "additionalProperties": false
}
